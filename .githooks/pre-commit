#!/bin/bash
# MeshForge Pre-Commit Hook
#
# Runs the linter on staged files and regression guard tests before each commit.
# This prevents known anti-patterns from being reintroduced (Issue #29).
#
# Setup: git config core.hooksPath .githooks
# Bypass: git commit --no-verify (use sparingly)

set -e

# Run MeshForge linter on staged files (errors only)
echo "Running MeshForge linter..."
if ! python3 scripts/lint.py --staged --severity error 2>/dev/null; then
    echo ""
    echo "Lint errors found. Fix before committing."
    echo "Run: python3 scripts/lint.py --staged"
    exit 1
fi

# Run regression guards (fast — file scanning only, no service deps)
echo "Running regression guards..."
if ! python3 -m pytest tests/test_regression_guards.py -x -q 2>/dev/null; then
    echo ""
    echo "Regression guard failed. A known anti-pattern was introduced."
    echo "Run: python3 -m pytest tests/test_regression_guards.py -v"
    exit 1
fi

# Parity-mirror execution gate (2026-07-02): byte-identical parity files must
# also EXECUTE here — a mirror commit that keeps canonical_message.py in sync
# but breaks its collaborators (the STEP-3 BridgedMessage.content_id gap,
# TypeError on every Canonical→Bridged for 2 days) is caught at commit time,
# not at the next crash-recovery sweep. parity_check proves BYTES, this proves
# the twin repo can RUN them. Fast: ~60 tests, <1s.
if git diff --cached --name-only | grep -qE '^src/gateway/(canonical_message|rns_bridge)\.py$'; then
    echo "Shared-contract surface changed — running canonical execution tests..."
    if ! python3 -m pytest tests/test_canonical_message.py -x -q 2>/dev/null; then
        echo ""
        echo "canonical_message execution tests failed — the parity file cannot"
        echo "run against this repo's collaborators (BridgedMessage et al.)."
        echo "Run: python3 -m pytest tests/test_canonical_message.py -v"
        exit 1
    fi
fi

# Error-path checklist advisory (2026-07-29, build:fix doctrine; ported from
# the MF twin): THE defect class (#80 — degraded state mapped to a
# valid-looking value) is born in the except-handlers of monitor code.
# Surface the write-time checklist at the exact moment the class can be
# born — only then, so it never becomes wallpaper. ADVISORY (never blocks):
# MF027 blocks the mechanical check_*/HealthResult subset; the checklist
# walk covers what a lint cannot see.
_added_excepts=$(git diff --cached -U0 -- 'src/utils/active_health_probe*.py' \
                     'src/mini_dudeai/*.py' 'src/utils/health_score.py' \
                     'src/utils/shared_health_state.py' \
                     2>/dev/null | grep -cE '^\+[^+].*\bexcept\b' || true)
if [ "${_added_excepts:-0}" -gt 0 ]; then
    echo ""
    echo "ADVISORY: this commit adds ${_added_excepts} except-handler line(s) in monitor code."
    echo "  Walk the honest-failure-modes checklist over the diff (30s per item):"
    echo "  does the degraded value overlap the healthy domain? absence of evidence"
    echo "  is not recovery; every swallow leaves a witness — HealthResult blindness"
    echo "  is healthy-with-REASON, never bare healthy=True."
    echo "  (MF027 catches only dark check_* except-returns — this walk is the rest.)"
fi

echo "Pre-commit checks passed."
