#!/bin/bash
# MeshAnchor pre-push hook
#
# Runs scripts/healthcheck.sh before pushing to keep CI from going red.
# Today (2026-05-03) we shipped two pushes that compounded a CI red
# baseline before the surface failure was even fixed; pre-push closes
# that loop. Bypass with `git push --no-verify` if you really need to.
#
# Setup: git config core.hooksPath .githooks (already on per CLAUDE.md)

set -u

# Only run on push to origin; skip for pushes to local sandboxes / forks
# (those are usually personal experiments). Adjust if your workflow
# differs.
remote="$1"
if [ "$remote" != "origin" ] && [ "$remote" != "meshanchor" ]; then
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"

if [ ! -x "$REPO_ROOT/scripts/healthcheck.sh" ]; then
    echo "scripts/healthcheck.sh not found or not executable — skipping pre-push check" >&2
    exit 0
fi

# Default: lint only — fast (~2s) and catches MF-rule violations
# (including MF016 which would have blocked the 2026-05-03 incident).
# This box runs as a real fleet member, so the local test suite has
# environmental failures (real meshtasticd/RNS/cached DB) that would
# always block a push without telling us anything CI-relevant. Lint
# is environment-independent and high-value.
#
# Opt-in escalation:
#   MESHANCHOR_PREPUSH_FULL=1  → run full test suite locally too
#   MESHANCHOR_PREPUSH_CLEAN=1 → run in clean CI-parity venv (slowest, most accurate)
if [ "${MESHANCHOR_PREPUSH_CLEAN:-0}" = "1" ]; then
    "$REPO_ROOT/scripts/healthcheck.sh" --clean-venv
elif [ "${MESHANCHOR_PREPUSH_FULL:-0}" = "1" ]; then
    "$REPO_ROOT/scripts/healthcheck.sh"
else
    "$REPO_ROOT/scripts/healthcheck.sh" --lint-only
fi
rc=$?

if [ "$rc" -ne 0 ]; then
    echo ""
    echo "Pre-push healthcheck failed. Fix issues or override with:"
    echo "  git push --no-verify"
    exit 1
fi

# Upshift-witness — compiles model_advisor's "queue, don't fake the frontier
# pass" behavior into a deterministic gate (scripts/review_provenance_check.py,
# twin-ported byte-identical from MeshForge 2026-07-16 after its first live
# firing there): leg 1 (review-claim commits must leave a provenance row) and
# leg 2 (a non-frontier session can't stamp a frontier-tier row) block; leg 3
# is an advisory nudge. Fails OPEN (warn, exit 0) on anything unobservable.
# The script prints its own remediation incl. the sanctioned rule-6 unblock
# and the --no-verify override, so the hook just relays its exit code.
if [ -f "$REPO_ROOT/scripts/review_provenance_check.py" ]; then
    echo "Pre-push: upshift-witness (review provenance)..."
    if ! python3 "$REPO_ROOT/scripts/review_provenance_check.py"; then
        echo ""
        echo "Upshift-witness gate FAILED (see above)."
        exit 1
    fi
fi

# Doc stat sentinels — 67ms (2026-09-09). On that day a single new test file in
# THIS repo (the test_mini_warmstart.py byte-lock port) bumped a
# filesystem-derived count and reddened CI, while the checker sat unwired here
# exactly as it did in MeshForge. Note --check: the bare invocation exits 2
# whether clean or drifted, so its raw exit code is NOT a gate signal.
SENTINELS_RAN=no
if [ -f "$REPO_ROOT/scripts/readme_stats.py" ]; then
    echo "Pre-push: doc stat sentinels..."
    if ! python3 "$REPO_ROOT/scripts/readme_stats.py" --check; then
        echo ""
        echo "Doc stat sentinel(s) drifted from the tree. Fix with:"
        echo "  python3 scripts/readme_stats.py --update   # then commit the docs change"
        echo "Override (sparingly): git push --no-verify"
        exit 1
    fi
    SENTINELS_RAN=yes
fi

# Byte-lock parity — THE ASYMMETRY THIS CLOSES (2026-09-09). parity_check.py
# lives only in MeshForge, the lead repo, so an edit made HERE to a byte-locked
# file could drift and this repo's own hook could not see it — it would surface
# only when MeshForge's suite next ran. Borrow the lead repo's checker when it is
# on this box. Tri-state: 1 = real drift and BLOCKS, anything else = parity is
# UNOBSERVABLE from here and must read as neither (honest_failure_modes #2).
PARITY_STATE="UNOBSERVABLE (MeshForge repo not on this box)"
MF_REPO="${MESHFORGE_REPO:-/opt/meshforge}"
if [ -f "$MF_REPO/scripts/parity_check.py" ]; then
    echo "Pre-push: byte-lock parity (via the lead repo's checker)..."
    python3 "$MF_REPO/scripts/parity_check.py" --meshanchor "$REPO_ROOT" \
        >/tmp/.ma_prepush_parity.out 2>&1
    prc=$?
    if [ "$prc" -eq 1 ]; then
        cat /tmp/.ma_prepush_parity.out
        echo ""
        echo "Byte-locked file(s) DRIFTED. MeshForge is the LEAD repo: land the"
        echo "change there first, then port here — not the other way round."
        rm -f /tmp/.ma_prepush_parity.out
        exit 1
    elif [ "$prc" -eq 0 ]; then
        PARITY_STATE="checked"
    else
        PARITY_STATE="UNOBSERVABLE (checker exit $prc)"
        echo "  WARN: parity unobservable — not a pass, not a failure."
    fi
    rm -f /tmp/.ma_prepush_parity.out
fi

# TWIN-FLEET DRIFT — an OBSERVATION, not a reminder (2026-09-09). This repo is
# pushed from the dev box and PULLED on its own fleet box; fleet_pull.sh
# already supports it (`fleet_pull.sh /opt/meshanchor`, per-repo host list
# fleet_hosts.meshanchor, both present since 2026-07-16). Nothing was missing
# but the CALL: four pushes landed that day with the deploy never run, and the
# check of record could not see it because honest_status's fleet-SHA leg is
# scoped to the MeshForge repo.
#
# ⚠️ This is a NUDGE and cannot be the fix. git has no post-push hook, so at
# this moment the push has not happened yet — the honest thing it can report is
# whether the box is ALREADY behind, which is a real finding on its own. It
# never blocks: being behind is a deploy state, not a bad commit. The actual
# gate for this class belongs in honest_status, AFTER the push.
#
# And note WHY prose was never going to work: this exact instruction was already
# written down in the operator's memory ("MA: push from VolcanoAI, PULL on
# meshanchor-server") and read at session start. It was still missed four times.
if [ -x "$MF_REPO/scripts/fleet_pull.sh" ]; then
    ma_target=$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || echo "")
    ma_list="$HOME/.config/meshforge/fleet_hosts.meshanchor"
    if [ -n "$ma_target" ] && [ -r "$ma_list" ]; then
        while read -r ma_box; do
            case "$ma_box" in ""|\#*) continue ;; esac
            ma_sha=$(timeout 20 ssh -o BatchMode=yes -o ConnectTimeout=8 "$ma_box" \
                     "git -C $REPO_ROOT rev-parse HEAD 2>/dev/null" 2>/dev/null || echo "")
            if [ -z "$ma_sha" ]; then
                echo "  NOTE: twin fleet box '$ma_box' UNREACHABLE — deploy state unknown."
            elif [ "$ma_sha" != "$ma_target" ]; then
                echo "  NOTE: twin fleet box '$ma_box' is BEHIND (${ma_sha:0:8} vs local ${ma_target:0:8})."
                echo "        It will be one further behind after this push. Deploy with:"
                echo "          bash $MF_REPO/scripts/fleet_pull.sh $REPO_ROOT"
            fi
        done < "$ma_list"
    fi
fi

# THE SCOPE STATEMENT. This hook used to end with a bare `exit 0` — silent,
# which a reader fills in as "fine". MeshForge's said "Pre-push checks passed."
# and that one line let four red-CI pushes through on 2026-09-09: the hook
# measured a SUBSET honestly and the pass was read as clearance. Both now state
# what they did NOT check, the same way fleet_truth's services cell now names
# its quantity instead of returning a bare HEALTHY.
if [ "$SENTINELS_RAN" = yes ]; then s_state="checked"; else s_state="skipped"; fi
echo ""
echo "Pre-push checks passed."
echo "  SCOPE: lint, regression guards, upshift-witness,"
echo "         doc sentinels ($s_state), byte-lock parity ($PARITY_STATE)."
echo "  NOT RUN: the full test suite, and CI."
echo "           This is a SUBSET. It does not license 'safe to push'."
exit 0
