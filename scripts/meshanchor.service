[Unit]
Description=MeshAnchor Mesh Network Operations Center
Documentation=https://github.com/Nursedude/meshanchor
After=network.target rnsd.service
# meshtasticd is optional gateway — not a hard dependency
After=meshtasticd.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/meshanchor
ExecStart=/usr/bin/python3 /opt/meshanchor/src/launcher.py --no-services
Restart=on-failure
RestartSec=10

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# MA017 audit-skip: launcher.py --no-services skips start_noc_services()
# entirely; this entry path doesn't write to meshanchor data buckets.
# Pattern-audit Finding #6 (2026-05-19) noted this unit's ProtectHome=
# read-only + /home in ReadWritePaths is a known systemd no-op per the
# companion meshanchor-daemon.service comment — investigating the real
# /home / /root write behaviour is deferred until the next time this
# unit is touched.
ReadWritePaths=/var/log /tmp /home  # audit-skip: see comment above
PrivateTmp=true

# Environment
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
