[Unit]
Description=MeshAnchor Daemon - Headless NOC Services
Documentation=https://github.com/Nursedude/meshanchor
After=network.target rnsd.service
# meshtasticd is optional gateway — not a hard dependency
After=meshtasticd.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/meshanchor
# ExecStartPre: pre-create the daemon's XDG paths under both /root and
# /home/wh6gxz. The `+` prefix runs the command with full privileges
# OUTSIDE the service mount namespace — necessary because the namespace
# is set up read-only and a non-prefixed mkdir would EROFS. The dirs
# then exist when ReadWritePaths bind-mounts them RW for ExecStart.
# Both prefixes are kept for cross-host compat: hosts without a
# SUDO_USER pin (e.g. VolcanoAI) resolve to /root, while hosts with the
# pin below resolve to /home/wh6gxz/. Both are idempotent.
ExecStartPre=+/bin/mkdir -p /root/.config/meshanchor /root/.local/share/meshanchor /root/.cache/meshanchor
ExecStartPre=+/bin/mkdir -p /home/wh6gxz/.config/meshanchor /home/wh6gxz/.local/share/meshanchor /home/wh6gxz/.cache/meshanchor
# Use venv if available, fall back to system Python (mirrors meshanchor-map.service)
ExecStart=/bin/bash -c 'if [ -x /opt/meshanchor/venv/bin/python ]; then exec /opt/meshanchor/venv/bin/python /opt/meshanchor/src/daemon.py start --foreground; else exec python3 /opt/meshanchor/src/daemon.py start --foreground; fi'
ExecStop=/bin/bash -c 'if [ -x /opt/meshanchor/venv/bin/python ]; then exec /opt/meshanchor/venv/bin/python /opt/meshanchor/src/daemon.py stop; else exec python3 /opt/meshanchor/src/daemon.py stop; fi'
ExecReload=/bin/kill -HUP $MAINPID
PIDFile=/run/meshanchor/meshanchord.pid
Restart=on-failure
RestartSec=10
# WatchdogSec intentionally absent: daemon.py does not send sd_notify(WATCHDOG=1).
# Adding one would SIGABRT the process every <interval>s for no reason.

# Runtime directory (auto-created by systemd)
RuntimeDirectory=meshanchor

# Security hardening (mirrors meshanchor.service)
NoNewPrivileges=true
ProtectSystem=strict
# ProtectHome= deliberately UNSET. Combining ProtectHome=read-only with
# ReadWritePaths=/home is a known systemd no-op: the read-only bind-mount of
# /home from ProtectHome is not overridden by a wide /home entry in
# ReadWritePaths (specific subpaths work, the parent doesn't). Without
# ProtectHome, /home in ReadWritePaths actually takes effect. The daemon
# already runs as root so ProtectHome buys little real isolation here, and
# ProtectSystem=strict still keeps everything else read-only.
# /root XDG subpaths kept (with `-` prefix so they're optional) for hosts
# where SUDO_USER is unset and get_real_user_home() resolves to /root.
ReadWritePaths=/var/log /run/meshanchor /home -/root/.config/meshanchor -/root/.local/share/meshanchor -/root/.cache/meshanchor
PrivateTmp=true

# Environment
# SUDO_USER closes deploy drift #6: User=root + no SUDO_USER caused
# get_real_user_home() to return /root, hiding the operator's gateway.json
# at /home/wh6gxz/.config/meshanchor/. With the pin, clean systemd restarts
# resolve the real user's home without requiring an /etc override file.
Environment=SUDO_USER=wh6gxz
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/meshanchor/src

[Install]
WantedBy=multi-user.target
