[Unit]
Description=Daily restart of meshanchor-map (workaround for Issue #131)
Documentation=https://github.com/Nursedude/meshanchor/issues/131

[Timer]
# Daily 04:37 HST. Stagger after the existing Sun-only restart timers
# (meshtasticd 02:30, meshanchor-daemon 03:30, meshforge-map 04:00) so the
# load stays gentle across the box. Cap on operator-visible outage is now
# ~24 h; expected steady-state degraded window is 30-60 min per cycle until
# #128 lands and this is retired.
# :37 (not :30) keeps the restart OFF the :00/:15/:30/:45 probe grid — the
# manager's */15 ma_health check hits at :XX:02 and a 04:30:00 restart made
# it catch "deactivating" every single day (2026-07-19 root cause).
OnCalendar=*-*-* 04:37:00
Persistent=true
Unit=meshanchor-map-restart.service

[Install]
WantedBy=timers.target
