# MeshAnchor - NomadNet User Service
# ==================================
#
# NomadNet MUST start AFTER rnsd so it connects as a client to
# rnsd's shared instance (port 37428) instead of fighting over it.
#
# Install:
#   pip install --user nomadnet
#   mkdir -p ~/.config/systemd/user
#   cp nomadnet-user.service ~/.config/systemd/user/nomadnet.service
#
# Enable:
#   systemctl --user daemon-reload
#   systemctl --user enable nomadnet
#   systemctl --user start nomadnet
#
# Persist after logout (required for headless/server):
#   loginctl enable-linger $USER
#
# IMPORTANT: rnsd must be the shared instance owner.
# Start order: rnsd -> nomadnet -> meshanchor
#
# Status:
#   systemctl --user status nomadnet

[Unit]
Description=NomadNet LXMF Client
After=default.target network-online.target rnsd.service
Wants=network-online.target
# Requires=rnsd.service intentionally omitted — when rnsd runs at the
# SYSTEM level (the common case on MeshAnchor boxes per Issue #41), a
# user-scope Requires= resolves to a user-scope rnsd.service that may
# not be installed, fails with 203/EXEC, and tears NomadNet down with
# it. After= still gives soft ordering. If you specifically run rnsd
# in user scope on this box, add `Requires=rnsd.service` here yourself.

[Service]
Type=simple
Restart=on-failure
RestartSec=5

# nomadnet binary installed by pip --user
ExecStart=%h/.local/bin/nomadnet --daemon

# Use user's config directory
Environment=HOME=%h

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nomadnet

[Install]
WantedBy=default.target
