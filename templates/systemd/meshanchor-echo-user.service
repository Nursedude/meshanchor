# MeshAnchor — lab echo responder (systemd-user, long-running)
# ============================================================
#
# Replies ACK to any inbound LXMF whose body parses as
# "PING seq=N from=<short>". Pairs with meshanchor-tracer.timer (the
# sender side) to produce per-pair RTT + reliability data.
#
# Identity at ~/.config/meshanchor/lab_echo_identity (auto-generated
# on first run). The destination hash is logged at startup —
# distribute it to peers via lab_peers files.
#
# Install (on every fleet box that should answer pings):
#   cp /opt/meshanchor/templates/systemd/meshanchor-echo-user.service \
#      ~/.config/systemd/user/meshanchor-echo.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now meshanchor-echo.service
#   journalctl --user -u meshanchor-echo --since "1 min ago" \
#       | grep "lab-echo destination"
#
# Bootstrap (one-time, to seed peers' lab_peers files before enabling):
#   python3 -m lab.lxmf_echo --init   # prints "<short>=<hash>"
#
# Operator notes:
#   - Restart=on-failure keeps the daemon up across transient RNS init
#     failures (which happen when rnsd restarts under us).
#   - Echo is stateless; LXMF storage lives in /tmp, swept each restart.
#   - See project_lab_traffic_soak_l1_plan.md for the broader arc.

[Unit]
Description=MeshAnchor lab echo responder (LXMF PING/ACK)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/meshanchor/src
ExecStart=/usr/bin/python3 -m lab.lxmf_echo
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=meshanchor-echo

[Install]
WantedBy=default.target
